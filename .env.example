# Cheapest: DeepSeek (https://platform.deepseek.com/api_keys). Used first when set.
DEEPSEEK_API_KEY=
# Optional — defaults to deepseek-flash
# DEEPSEEK_MODEL=deepseek-flash

# Backup: Anthropic (https://console.anthropic.com/settings/keys). Used if DeepSeek is unset or fails.
ANTHROPIC_API_KEY=

# Optional — default Anthropic model (moth sends Haiku from the browser).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Sonnet/Opus in ANTHROPIC_MODEL or in client requests are rewritten to Haiku unless you set:
# ANTHROPIC_ALLOW_SONNET=true
